{
  "name": "stampyx-ui",
  "version": "0.0.0",
  "description": "Panel for Stampyx: self-hosted email infrastructure.",
  "private": true,
  "packageManager": "yarn@1.22.22",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "lint": "eslint \"src/**/*.{ts,html}\" --max-warnings=0",
    "lint:fix": "eslint \"src/**/*.{ts,html}\" --fix && prettier \"src/**/*.{ts,html}\" --write",
    "format": "prettier \"src/**/*.{ts,html}\" --write",
    "format:check": "prettier \"src/**/*.{ts,html}\" --check",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "dependencies": {
    "@angular/cdk": "^22.0.0",
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@jsverse/transloco": "^8.4.0",
    "@primeuix/themes": "^3.0.0",
    "chart.js": "^4.5.1",
    "keycloak-angular": "^22.0.0",
    "keycloak-js": "^26.2.4",
    "primeicons": "^8.0.0",
    "primeng": "^22.0.0",
    "quill": "^2.0.3",
    "rxjs": "~7.8.0",
    "socket.io-client": "^4.8.1",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.2",
    "@angular/cli": "^22.1.2",
    "@angular/compiler-cli": "^22.1.0",
    "@eslint/js": "^9.33.0",
    "@tailwindcss/postcss": "^4.1.12",
    "@types/node": "^20.17.19",
    "angular-eslint": "^22.0.0",
    "eslint": "^9.33.0",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^28.0.0",
    "postcss": "^8.5.3",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.1.12",
    "tailwindcss-primeui": "^0.6.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.39.1",
    "vitest": "^4.0.8"
  }
}
